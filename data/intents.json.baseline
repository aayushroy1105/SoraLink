  "intents": [
    {
      "intent_id": "medical_help",
      "priority": "URGENT",
      "description": "Passenger reports illness, pain, bleeding, breathing trouble, or needs medical attention from the crew.",
      "labels": {
        "en": "Medical help needed",
        "ja": "医療の助けが必要です",
        "hi": "चिकित्सकीय सहायता चाहिए",
        "pa": "ਮੈਡੀਕਲ ਮਦਦ ਚਾਹੀਦੀ ਹੈ"
